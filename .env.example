# ---- server ----
PORT=8787
HOST=0.0.0.0

# ---- ingest loop ----
INGEST_INTERVAL_MS=20000
INGEST_LIMIT=25
INGEST_CONCURRENCY=6
INGEST_AUTOSTART=true

# ---- sources (toggle any off) ----
SOURCE_HACKERNEWS=true
SOURCE_GITHUB=true
SOURCE_REDDIT=true
SOURCE_SYNTHETIC=true

HN_QUERIES=looking for a tool,recommend a tool,alternative to,which platform should I use,need a solution for
HN_TAGS=story,comment
HN_HITS_PER_QUERY=12
HN_MIN_POINTS=0

REDDIT_SUBREDDITS=SaaS,startups,devops,webdev,smallbusiness,Entrepreneur
REDDIT_LISTING=new
REDDIT_USER_AGENT=intent-sniper/1.0 (hackathon demo; contact: demo@example.com)

# Optional free GitHub PAT -> 5000 req/hr instead of 60
GITHUB_TOKEN=
GITHUB_QUERIES="looking for a tool" in:title type:issue,"is there a tool that" in:title type:issue,"recommend a" in:title type:issue
GITHUB_PER_QUERY=12

SYNTHETIC_BATCH=12
SYNTHETIC_SEED=1337

# ---- Scoring provider ----
# auto | jev | typesafe | gateway | openrouter | heuristic
JEV_PROVIDER=auto
JEV_TIMEOUT_MS=12000

# TypeSafe Jev decision model (POST .../decisions). Key falls back to OPENROUTER_API_KEY.
JEV_API_KEY=
JEV_DECISION_BASE_URL=https://openrouter.ai/api/alpha
JEV_DECISION_MODEL=typesafe/jev-1.14

TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
JEV_MODEL=typesafe-ai/jev

# OpenRouter chat models (OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_REFERER=http://localhost:8787
OPENROUTER_TITLE=IntentSniper

# ---- routing thresholds ----
ROUTE_AUTO_INTENT=0.85
ROUTE_AUTO_CONFIDENCE=0.8
ROUTE_AUTO_URGENCY=6
ROUTE_REVIEW_INTENT=0.45
ROUTE_INJECTION_THRESHOLD=0.5

# ---- SDR webhook (Slack/Discord compatible JSON) ----
SDR_WEBHOOK_URL=

# ---- store ----
DATA_DIR=data
PERSIST=true
STORE_MAX=3000
